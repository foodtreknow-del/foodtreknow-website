{
  "name": "foodtreknow-website",
  "version": "1.0.0",
  "private": true,
  "description": "FoodTrekNow customer ordering and food truck operations platform",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "mobile:sync": "npm run build:web && cap sync",
    "mobile:sync:android": "npm run build:web && cap sync android",
    "mobile:assets:android": "capacitor-assets generate --android --assetPath resources --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#ffffff\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#ffffff\" --logoSplashScale 0.28",
    "mobile:add:android": "npm run build:web && cap add android",
    "mobile:add:ios": "npm run build:web && cap add ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
